# =========================================================================
# SOLEVAULT - PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. Supabase Cloud Database (PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 2. Marketing Pixels Tracking
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# 3. Store Identity & Shipping Carrier
NEXT_PUBLIC_STORE_NAME=SOLEVAULT
NEXT_PUBLIC_STORE_TAGLINE="Where Rare Meets the Street"
NEXT_PUBLIC_SHIPPING_PARTNER=Bosta
